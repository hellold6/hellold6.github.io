# Copy this file to .env locally, and set these as Environment Variables in Render's dashboard for deployment.

# Connection string from Supabase: Project Settings -> Database -> Connection string (URI, "Session" mode)
DATABASE_URL=postgresql://postgres:[email protected]:5432/postgres

# Any long random string. Generate one with: openssl rand -hex 32
JWT_SECRET=change_this_to_something_long_and_random

# The password YOU will use to log into the admin dashboard. Pick something strong.
ADMIN_PASSWORD=change_this_too

# Your GitHub Pages URL, so only your site can talk to this server. Example:
ALLOWED_ORIGIN=https://hellold6.github.io

PORT=3000
